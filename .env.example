# Supabase の Project Settings > API からコピーする
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- ここから下はローカルのシードスクリプト (npm run seed) 専用 ---
# service_role キーは RLS を全て素通りする管理者用の鍵。
# VITE_ を付けるとブラウザのバンドルに埋め込まれてしまうので絶対に付けない。
# Supabase の Project Settings > API > service_role からコピーする
SUPABASE_SERVICE_ROLE_KEY=

# 投稿者にしたいアカウントのメールアドレス。未指定なら最初のユーザーを使う
SEED_USER_EMAIL=
